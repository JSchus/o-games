  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
