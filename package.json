{
  "name": "o-games",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.18" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
